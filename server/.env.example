# Blitztext-Proxy – Umgebungsvariablen
# Echte Werte gehoeren in /opt/blitztext-proxy/.env (Rechte 600, NICHT ins Git).

# Echter OpenAI-API-Key (sk-...). Liegt nur hier auf dem Server.
OPENAI_API_KEY=

# Frei waehlbares App-Passwort. Das tragen die Macs ins "OpenAI API Key"-Feld
# von Blitztext ein. Wird ans Team verteilt. Bei Verdacht hier aendern.
APP_PASSWORD=

# Port, auf dem der Proxy lokal lauscht (nur 127.0.0.1, nginx davor).
PORT=3020
