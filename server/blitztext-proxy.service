[Unit]
Description=Blitztext-Proxy (OpenAI-Key-Schutz fuer Blitztext-App)
After=network.target

[Service]
Type=simple
User=blitztext
WorkingDirectory=/opt/blitztext-proxy
EnvironmentFile=/opt/blitztext-proxy/.env
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
